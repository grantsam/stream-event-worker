NODE_ENV=development
APP_MODE=dry-run
LOG_LEVEL=info
# Transport configuration: 'mock' for local dry-run, 'live-session' for account connection
TRANSPORT_ADAPTER=mock

TIMEZONE=Asia/Jakarta
TARGET_THREAD_ID=replace-with-test-thread
AUTHORIZED_SENDER_IDS=replace-with-test-sender
TRIGGER_PHRASES=open book
RESPONSE_TEXT=Me down

ACTIVE_WINDOWS=MON-SUN@00:00-23:59
COOLDOWN_MS=300000
MAX_EVENT_AGE_MS=10000

# Live session & Anti-bot settings
APP_STATE_PATH=./data/appstate.json
TYPING_DELAY_MS=150
SIMULATE_TYPING=true

HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000
STATE_DB_PATH=./data/worker.sqlite
METRICS_ENABLED=false

